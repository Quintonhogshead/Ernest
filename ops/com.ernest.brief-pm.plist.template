<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN"
  "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key><string>com.ernest.brief-pm</string>
  <key>WorkingDirectory</key><string>__ERNEST_DIR__</string>
  <key>ProgramArguments</key>
  <array>
    <string>__PYTHON__</string>
    <string>-m</string>
    <string>jobs.brief</string>
    <string>evening</string>
  </array>
  <key>StartCalendarInterval</key>
  <dict><key>Hour</key><integer>21</integer><key>Minute</key><integer>0</integer></dict>
  <key>StandardOutPath</key><string>__ERNEST_DIR__/logs/launchd-brief-pm.log</string>
  <key>StandardErrorPath</key><string>__ERNEST_DIR__/logs/launchd-brief-pm.log</string>
</dict>
</plist>
