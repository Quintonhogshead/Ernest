# ── Models (provider:model specs; no model ID is ever hard-coded in the code) ──
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
ERNEST_TRIAGE_MODEL=anthropic:claude-haiku-4-5
ERNEST_ASK_MODEL=anthropic:claude-sonnet-5
ERNEST_RESEARCH_MODEL=anthropic:claude-opus-5
ERNEST_EMBED_MODEL=openai:text-embedding-3-small

# ── Your channel: Discord bot (must share a private server with you) ──
ERNEST_DISCORD_TOKEN=
ERNEST_DISCORD_USER_ID=

# ── Canvas (optional) ──
# Preferred: an access token (Account → Settings → New Access Token).
CANVAS_BASE_URL=
CANVAS_TOKEN=
# No-token fallback for schools that disable tokens (e.g. UCF): the secret
# Calendar Feed URL (Canvas → Calendar → "Calendar Feed"). Due dates only.
CANVAS_ICS_URL=

# ── Mail accounts (read-only) ──
# Each entry is provider:name. Providers: gmail, outlook. A bare name = gmail.
# Example: two Gmail + two Outlook accounts:
ERNEST_ACCOUNTS=gmail:work,gmail:personal,outlook:business,outlook:school
GOOGLE_CREDENTIALS_DIR=./state/google
# Outlook / Microsoft 365 (register a public client in Azure/Entra; see README):
MS_CLIENT_ID=
MS_TENANT=common

# ── Priority alerts (always DM you immediately, overriding the model) ──
# Senders: full addresses or bare domains (substring match). Keywords: in subject/body.
ERNEST_PRIORITY_SENDERS=
ERNEST_PRIORITY_KEYWORDS=

# ── News desk ──
ERNEST_NEWS_FEEDS=

# ── Library / research ──
ERNEST_INGEST=1
ERNEST_RESEARCH_BUDGET_USD=5

# ── Weather (optional; brief skips the line if unset) ──
ERNEST_LAT=
ERNEST_LON=

# ── Kill switch (any value halts all writing jobs; readers keep logging) ──
# ERNEST_PAUSED=1
