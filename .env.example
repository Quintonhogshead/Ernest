# ── Models (provider:model specs; no model ID is ever hard-coded in the code) ──
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
ERNEST_TRIAGE_MODEL=anthropic:claude-haiku-4-5
ERNEST_ASK_MODEL=anthropic:claude-sonnet-5
ERNEST_RESEARCH_MODEL=anthropic:claude-opus-5
ERNEST_EMBED_MODEL=openai:text-embedding-3-small

# ── Your channel: Discord bot (must share a private server with you) ──
ERNEST_DISCORD_TOKEN=
ERNEST_DISCORD_USER_ID=

# ── Canvas (Account → Settings → New Access Token) ──
CANVAS_BASE_URL=
CANVAS_TOKEN=

# ── Gmail (read-only) ──
GOOGLE_CREDENTIALS_DIR=./state/google
ERNEST_ACCOUNTS=work,school,business

# ── News desk ──
ERNEST_NEWS_FEEDS=

# ── Library / research ──
ERNEST_INGEST=1
ERNEST_RESEARCH_BUDGET_USD=5

# ── Weather (optional; brief skips the line if unset) ──
ERNEST_LAT=
ERNEST_LON=

# ── Kill switch (any value halts all writing jobs; readers keep logging) ──
# ERNEST_PAUSED=1
